# Conexão com o banco de dados PostgreSQL
# DATABASE_URL: pooler de conexões, usado pela aplicação
# DIRECT_URL: conexão direta, exigida pelas migrations do Prisma
#
# Caracteres especiais na senha precisam ser codificados na URL:
# @ = %40   # = %23   % = %25   : = %3A   / = %2F

DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# Porta em que a API vai rodar
PORT=3000